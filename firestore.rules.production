rules_version = '2';
// Strict Production Rules — Activate after upgrading Firebase to Blaze and deploying `functions/`.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && userExists(request.auth.uid)
        && (
          userDoc(request.auth.uid).get('role', 'customer') == 'admin'
          || userDoc(request.auth.uid).get('isAdmin', false) == true
        );
    }

    function isNotBanned() {
      return signedIn() && (
        !userExists(request.auth.uid)
        || userDoc(request.auth.uid).get('isBanned', false) != true
      );
    }

    function unchanged(field) {
      return !(field in request.resource.data)
        || ((field in resource.data) && request.resource.data[field] == resource.data[field]);
    }

    function chatExists(threadId) {
      return exists(/databases/$(database)/documents/chats/$(threadId));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'customer'
        && request.resource.data.isAdmin == false
        && (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false)
        && (!('soldCount' in request.resource.data) || request.resource.data.soldCount == 0)
        && (!('boughtCount' in request.resource.data) || request.resource.data.boughtCount == 0)
        && (!('ratingSum' in request.resource.data) || request.resource.data.ratingSum == 0)
        && (!('ratingCount' in request.resource.data) || request.resource.data.ratingCount == 0);
      allow update: if isAdmin() || (isOwner(userId)
        && unchanged('role')
        && unchanged('isAdmin')
        && unchanged('isBanned')
        && unchanged('soldCount')
        && unchanged('boughtCount')
        && unchanged('ratingSum')
        && unchanged('ratingCount')
        && unchanged('verifiedStudent'));
      allow delete: if isAdmin();

      match /favorites/{listingId} {
        allow read, create, delete: if isOwner(userId);
        allow update: if false;
      }
    }

    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /phone_directory/{phoneKey} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && isNotBanned();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if isNotBanned()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'available'
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && (!('statsCounted' in request.resource.data) || request.resource.data.statsCounted == false);
      allow update: if isAdmin() || (isNotBanned()
        && resource.data.sellerId == request.auth.uid
        && unchanged('sellerId')
        && unchanged('statsCounted')
        && unchanged('feePaid')
        && unchanged('feeTransactionId')
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'available' && request.resource.data.status == 'reserved')
          || (resource.data.status == 'reserved' && request.resource.data.status == 'available')
        ));
      allow delete: if isAdmin() || (isNotBanned() && resource.data.sellerId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isNotBanned()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 800;
        allow update: if false;
        allow delete: if isAdmin() || (isNotBanned() && (
          resource.data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid
        ));
      }
    }

    match /offers/{offerId} {
      allow read: if isAdmin() || (signedIn()
        && (resource == null
          || resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid));
      allow create: if isNotBanned()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.status == 'pending'
        && (!('feePaid' in request.resource.data) || request.resource.data.feePaid == false)
        && (!('handoverCode' in request.resource.data) || request.resource.data.handoverCode == '');
      allow update: if isAdmin() || (isNotBanned()
        && (resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid)
        && unchanged('buyerId')
        && unchanged('sellerId')
        && unchanged('listingId')
        && unchanged('feePaid')
        && unchanged('feeTransactionId')
        && unchanged('handoverCode')
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && (
          (resource.data.status in ['pending', 'countered']
            && request.resource.data.status in ['countered', 'declined', 'withdrawn'])
          || (resource.data.status == 'accepted'
            && request.resource.data.status in ['declined', 'withdrawn']
            && unchanged('amount'))
        ));
      allow delete: if isAdmin();

      match /private/{docId} {
        allow read: if signedIn()
          && (isAdmin()
            || get(/databases/$(database)/documents/offers/$(offerId)).data.buyerId == request.auth.uid);
        allow write: if false;
      }
    }

    match /chats/{threadId} {
      allow create: if isNotBanned()
        && request.auth.uid in request.resource.data.get('participants', []);
      allow read: if isAdmin() || (signedIn() && (
        resource == null
        || request.auth.uid in resource.data.get('participants', [])
      ));
      allow update: if isAdmin() || (isNotBanned()
        && request.auth.uid in resource.data.get('participants', []));
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAdmin() || (signedIn() && (
          !chatExists(threadId)
          || request.auth.uid in get(/databases/$(database)/documents/chats/$(threadId)).data.get('participants', [])
        ));
        allow create: if isNotBanned()
          && request.resource.data.senderId == request.auth.uid
          && chatExists(threadId)
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(threadId)).data.get('participants', []);
        allow update, delete: if false;
      }
    }

    match /ratings/{listingId} {
      allow read: if true;
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if isNotBanned()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }

    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platform_metrics/{metricId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
  }
}
